<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="WinFullInstall - Laboratorio FEELT"
           Language="1046"
           Version="1.0.0.0"
           Manufacturer="FEELT/LASEC"
           UpgradeCode="2D556EBA-1500-4590-B277-A6F4794905F3">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Instala/executa todos os componentes do laboratorio (driver NVIDIA GTX 1650, driver de chipset AMD B550, OpenJDK, 7-Zip, Anaconda3, CODESYS, Scada-LTS, process_simul, ININDUFU, USB/IP ThinClient Gateway) e configura o servidor (AD DS + RDS)."
             Comments="Requer que a pasta C:\Prof_Jouse\00Instal\WinFullInstall\componentes com todos os instaladores esteja presente." />

    <MajorUpgrade DowngradeErrorMessage="Uma versao mais recente do WinFullInstall ja esta instalada." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="WinFullInstall" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="WinFullInstall" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallAllScript" Guid="C591D928-A96C-44D9-943E-310967C7987A">
        <File Id="InstallAllPs1" Source="..\componentes\Install-All.ps1" KeyPath="yes" />
      </Component>
      <Component Id="LaunchElevatedScript" Guid="6C2C1F0B-7B7A-4C7A-9D2E-8E2C7B4F1A3D">
        <File Id="LaunchElevatedPs1" Source="..\componentes\Launch-Elevated.ps1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="0362E2A5-692D-428E-9EBA-BDE2A0C96C4F">
        <Shortcut Id="InstallAllShortcut"
                  Name="Instalar tudo - Laboratorio FEELT"
                  Description="Executa todos os instaladores e configura o servidor (AD DS + RDS) - pede elevacao UAC"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File &quot;[INSTALLFOLDER]Launch-Elevated.ps1&quot;"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\FEELT\WinFullInstall" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="WinFullInstall" Level="1">
      <ComponentRef Id="InstallAllScript" />
      <ComponentRef Id="LaunchElevatedScript" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- Lanca o orquestrador em uma janela visivel ao final da instalacao,
         sem bloquear o termino do MSI (asyncNoWait), em contexto do
         usuario que executou o instalador (impersonate). -->
    <CustomAction Id="LaunchInstallAll"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[System64Folder]WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File &quot;[INSTALLFOLDER]Install-All.ps1&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchInstallAll" After="InstallFinalize">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
